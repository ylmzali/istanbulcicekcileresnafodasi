# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env
.env.*
.env.local
.env.*.local
!.env.example
!.env.production.example

# Coolify local practice secrets (never commit)
/deploy/coolify/practice-database.env
/deploy/coolify/*.local.env


# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

# local agent tooling (keep Tailwind/Turbopack from scanning these)
/.agents
/.claude
/.windsurf
/skills-lock.json

# user uploads
/public/uploads/**
!/public/uploads/.gitkeep
/storage/resources/**
!/storage/resources/.gitkeep
/storage/applications/**
!/storage/applications/.gitkeep
/storage/receipts/**
!/storage/receipts/.gitkeep
