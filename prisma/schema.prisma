generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum UserStatus {
  active
  suspended
  disabled
}

enum MemberStatus {
  pending
  active
  suspended
  passive
  cancelled
  deceased
}

enum ApplicationStatus {
  draft
  submitted
  under_review
  missing_documents
  approved
  rejected
  cancelled
}

enum DocumentRequestStatus {
  draft
  submitted
  payment_pending
  under_review
  approved
  ready
  delivered
  rejected
  cancelled
}

enum IssuedDocumentStatus {
  valid
  expired
  revoked
}

enum DueStatus {
  unpaid
  partially_paid
  paid
  waived
  overdue
}

enum PaymentStatus {
  pending
  processing
  paid
  failed
  cancelled
  refunded
  partially_refunded
}

enum PaymentMethod {
  online
  cash
  bank_transfer
  pos
  other
}

enum AppointmentStatus {
  pending
  confirmed
  completed
  cancelled_by_member
  cancelled_by_staff
  no_show
}

enum SupportRequestType {
  information
  complaint
  suggestion
  support
}

enum SupportRequestStatus {
  new
  assigned
  in_progress
  waiting_for_applicant
  resolved
  closed
}

enum SupportMessageVisibility {
  public
  internal
}

enum PostType {
  news
  announcement
  sector
}

enum ContentStatus {
  draft
  in_review
  scheduled
  published
  archived
}

enum ResourceVisibility {
  public
  members
  staff
}

enum MediaVisibility {
  public
  private
}

enum BusinessVerificationStatus {
  unverified
  verified
  rejected
}

enum EventRegistrationStatus {
  registered
  waitlisted
  cancelled
  attended
}

enum JobStatus {
  pending
  processing
  completed
  failed
}

// ─── Auth & RBAC ─────────────────────────────────────────────────────────────

model User {
  id               String     @id @default(cuid())
  username         String?    @unique @db.VarChar(80)
  memberNo         String?    @unique @map("member_no") @db.VarChar(40)
  email            String?    @unique @db.VarChar(190)
  phone            String?    @db.VarChar(30)
  passwordHash     String     @map("password_hash") @db.VarChar(255)
  status           UserStatus @default(active)
  twoFactorEnabled Boolean    @default(false) @map("two_factor_enabled")
  twoFactorSecret  String?    @map("two_factor_secret") @db.VarChar(255)
  lastLoginAt      DateTime?  @map("last_login_at")
  createdAt        DateTime   @default(now()) @map("created_at")
  updatedAt        DateTime   @updatedAt @map("updated_at")
  deletedAt        DateTime?  @map("deleted_at")

  roles                    UserRole[]
  sessions                 Session[]
  passwordResetTokens      PasswordResetToken[]
  member                   Member?
  membershipApplications   MembershipApplication[] @relation("ApplicantUser")
  assignedApplications     MembershipApplication[] @relation("AssignedStaff")
  assignedDocumentRequests DocumentRequest[]       @relation("AssignedDocumentStaff")
  createdPayments          Payment[]               @relation("PaymentCreatedBy")
  appointmentsAsMember     Appointment[]           @relation("AppointmentMemberUser")
  appointmentsAsStaff      Appointment[]           @relation("AppointmentStaffUser")
  assignedSupportRequests  SupportRequest[]        @relation("SupportAssignee")
  supportMessages          SupportMessage[]
  uploadedMedia            Media[]                 @relation("MediaUploader")
  notifications            Notification[]
  auditLogs                AuditLog[]              @relation("AuditActor")
  eventRegistrations       EventRegistration[]

  @@index([status])
  @@map("users")
}

model Role {
  id          String   @id @default(cuid())
  name        String   @unique @db.VarChar(80)
  displayName String   @map("display_name") @db.VarChar(120)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  users       UserRole[]
  permissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String   @id @default(cuid())
  name        String   @unique @db.VarChar(120)
  displayName String   @map("display_name") @db.VarChar(160)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  roles RolePermission[]

  @@map("permissions")
}

model UserRole {
  userId     String   @map("user_id")
  roleId     String   @map("role_id")
  assignedAt DateTime @default(now()) @map("assigned_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

model RolePermission {
  roleId       String @map("role_id")
  permissionId String @map("permission_id")

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model Session {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  tokenHash String   @unique @map("token_hash") @db.VarChar(255)
  ipHash    String?  @map("ip_hash") @db.VarChar(128)
  userAgent String?  @map("user_agent") @db.VarChar(512)
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String    @map("user_id")
  tokenHash String    @unique @map("token_hash") @db.VarChar(255)
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

// ─── Members & businesses ────────────────────────────────────────────────────

model City {
  id        String   @id @default(cuid())
  name      String   @db.VarChar(120)
  slug      String   @unique @db.VarChar(140)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  districts District[]

  @@map("cities")
}

model District {
  id        String   @id @default(cuid())
  cityId    String   @map("city_id")
  name      String   @db.VarChar(120)
  slug      String   @unique @db.VarChar(140)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  city     City              @relation(fields: [cityId], references: [id], onDelete: Restrict)
  businesses Business[]
  branches   BusinessBranch[]

  @@index([cityId])
  @@index([name])
  @@map("districts")
}

model Member {
  id               String       @id @default(cuid())
  userId           String       @unique @map("user_id")
  memberNo         String       @unique @map("member_no") @db.VarChar(40)
  identityNoEnc    String?      @map("identity_no_encrypted") @db.Text
  /** HMAC lookup hash for login by T.C. (not reversible) */
  identityNoHash   String?      @unique @map("identity_no_hash") @db.VarChar(128)
  /** Halkbank tahsilat numarası (Tahsilat ID) */
  collectionRef    String?      @map("collection_ref") @db.VarChar(80)
  status           MemberStatus @default(pending)
  registrationDate DateTime?    @map("registration_date") @db.Date
  terminationDate  DateTime?    @map("termination_date") @db.Date
  directoryConsent Boolean      @default(false) @map("directory_consent")
  createdAt        DateTime     @default(now()) @map("created_at")
  updatedAt        DateTime     @updatedAt @map("updated_at")
  deletedAt        DateTime?    @map("deleted_at")

  user               User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  profile            MemberProfile?
  businesses         Business[]
  statusHistory      MemberStatusHistory[]
  documentRequests   DocumentRequest[]
  dues               MemberDue[]
  payments           Payment[]
  appointments       Appointment[]           @relation("AppointmentMember")
  supportRequests    SupportRequest[]
  eventRegistrations EventRegistration[]

  @@index([status])
  @@index([memberNo])
  @@map("members")
}

model MemberProfile {
  id               String   @id @default(cuid())
  memberId         String   @unique @map("member_id")
  firstName        String   @map("first_name") @db.VarChar(120)
  lastName         String   @map("last_name") @db.VarChar(120)
  birthDate        DateTime? @map("birth_date") @db.Date
  preferredContact String?  @map("preferred_contact") @db.VarChar(40)
  addressLine1     String?  @map("address_line1") @db.VarChar(255)
  addressLine2     String?  @map("address_line2") @db.VarChar(255)
  postalCode       String?  @map("postal_code") @db.VarChar(20)
  countryCode      String   @default("TR") @map("country_code") @db.VarChar(2)
  cityName         String?  @map("city_name") @db.VarChar(120)
  districtName     String?  @map("district_name") @db.VarChar(120)
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@map("member_profiles")
}

model MemberStatusHistory {
  id         String       @id @default(cuid())
  memberId   String       @map("member_id")
  fromStatus MemberStatus? @map("from_status")
  toStatus   MemberStatus @map("to_status")
  reason     String?      @db.VarChar(500)
  changedBy  String?      @map("changed_by")
  createdAt  DateTime     @default(now()) @map("created_at")

  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([memberId])
  @@map("member_status_history")
}

model BusinessCategory {
  id        String   @id @default(cuid())
  name      String   @db.VarChar(160)
  slug      String   @unique @db.VarChar(180)
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  businesses BusinessCategoryRelation[]

  @@map("business_categories")
}

model Business {
  id                 String                      @id @default(cuid())
  memberId           String                      @map("member_id")
  legalName          String                      @map("legal_name") @db.VarChar(255)
  tradeName          String?                     @map("trade_name") @db.VarChar(255)
  taxOffice          String?                     @map("tax_office") @db.VarChar(120)
  taxNoEnc           String?                     @map("tax_no_encrypted") @db.Text
  phone              String?                     @db.VarChar(30)
  email              String?                     @db.VarChar(190)
  website            String?                     @db.VarChar(255)
  description        String?                     @db.Text
  countryCode        String                      @default("TR") @map("country_code") @db.VarChar(2)
  districtId         String?                     @map("district_id")
  address            String?                     @db.VarChar(500)
  latitude           Decimal?                    @db.Decimal(10, 7)
  longitude          Decimal?                    @db.Decimal(10, 7)
  directoryVisible   Boolean                     @default(false) @map("directory_visible")
  verificationStatus BusinessVerificationStatus  @default(unverified) @map("verification_status")
  createdAt          DateTime                    @default(now()) @map("created_at")
  updatedAt          DateTime                    @updatedAt @map("updated_at")
  deletedAt          DateTime?                   @map("deleted_at")

  member     Member                      @relation(fields: [memberId], references: [id], onDelete: Cascade)
  district   District?                   @relation(fields: [districtId], references: [id], onDelete: SetNull)
  branches   BusinessBranch[]
  categories BusinessCategoryRelation[]

  @@index([memberId])
  @@index([districtId])
  @@index([directoryVisible, verificationStatus])
  @@map("businesses")
}

model BusinessCategoryRelation {
  businessId String @map("business_id")
  categoryId String @map("category_id")

  business Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  category BusinessCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([businessId, categoryId])
  @@map("business_category_relations")
}

model BusinessBranch {
  id         String   @id @default(cuid())
  businessId String   @map("business_id")
  name       String   @db.VarChar(160)
  address    String?  @db.VarChar(500)
  districtId String?  @map("district_id")
  latitude   Decimal? @db.Decimal(10, 7)
  longitude  Decimal? @db.Decimal(10, 7)
  phone      String?  @db.VarChar(30)
  isPrimary  Boolean  @default(false) @map("is_primary")
  status     String   @default("active") @db.VarChar(40)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  business Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  district District? @relation(fields: [districtId], references: [id], onDelete: SetNull)

  @@index([businessId])
  @@index([districtId])
  @@map("business_branches")
}

// ─── Applications & documents ────────────────────────────────────────────────

model MembershipApplication {
  id           String            @id @default(cuid())
  userId       String?           @map("user_id")
  trackingNo   String            @unique @map("tracking_no") @db.VarChar(40)
  status       ApplicationStatus @default(draft)
  formData     Json              @map("form_data")
  submittedAt  DateTime?         @map("submitted_at")
  assignedToId String?           @map("assigned_to")
  decisionNote String?           @map("decision_note") @db.Text
  decidedAt    DateTime?         @map("decided_at")
  createdAt    DateTime          @default(now()) @map("created_at")
  updatedAt    DateTime          @updatedAt @map("updated_at")
  deletedAt    DateTime?         @map("deleted_at")

  user      User?                      @relation("ApplicantUser", fields: [userId], references: [id], onDelete: SetNull)
  assignee  User?                      @relation("AssignedStaff", fields: [assignedToId], references: [id], onDelete: SetNull)
  documents ApplicationDocument[]
  history   ApplicationStatusHistory[]

  @@index([status])
  @@index([trackingNo])
  @@index([assignedToId])
  @@map("membership_applications")
}

model ApplicationStatusHistory {
  id            String            @id @default(cuid())
  applicationId String            @map("application_id")
  fromStatus    ApplicationStatus? @map("from_status")
  toStatus      ApplicationStatus @map("to_status")
  note          String?           @db.VarChar(500)
  changedBy     String?           @map("changed_by")
  createdAt     DateTime          @default(now()) @map("created_at")

  application MembershipApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId])
  @@map("application_status_history")
}

model DocumentType {
  id            String   @id @default(cuid())
  name          String   @db.VarChar(160)
  slug          String   @unique @db.VarChar(180)
  requirements  String?  @db.Text
  fee           Decimal  @default(0) @db.Decimal(12, 2)
  validityDays  Int?     @map("validity_days")
  active        Boolean  @default(true)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  applicationDocuments ApplicationDocument[]
  documentRequests     DocumentRequest[]

  @@map("document_types")
}

model ApplicationDocument {
  id                 String   @id @default(cuid())
  applicationId      String   @map("application_id")
  documentTypeId     String?  @map("document_type_id")
  storageKey         String   @map("storage_key") @db.VarChar(500)
  originalName       String   @map("original_name") @db.VarChar(255)
  mimeType           String   @map("mime_type") @db.VarChar(120)
  size               Int
  verificationStatus String   @default("pending") @map("verification_status") @db.VarChar(40)
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  application  MembershipApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  documentType DocumentType?         @relation(fields: [documentTypeId], references: [id], onDelete: SetNull)

  @@index([applicationId])
  @@map("application_documents")
}

model DocumentRequest {
  id             String                @id @default(cuid())
  memberId       String                @map("member_id")
  documentTypeId String                @map("document_type_id")
  trackingNo     String                @unique @map("tracking_no") @db.VarChar(40)
  status         DocumentRequestStatus @default(draft)
  purpose        String?               @db.VarChar(500)
  deliveryMethod String?               @map("delivery_method") @db.VarChar(40)
  fee            Decimal               @default(0) @db.Decimal(12, 2)
  assignedToId   String?               @map("assigned_to")
  createdAt      DateTime              @default(now()) @map("created_at")
  updatedAt      DateTime              @updatedAt @map("updated_at")
  deletedAt      DateTime?             @map("deleted_at")

  member       Member                         @relation(fields: [memberId], references: [id], onDelete: Cascade)
  documentType DocumentType                   @relation(fields: [documentTypeId], references: [id], onDelete: Restrict)
  assignee     User?                          @relation("AssignedDocumentStaff", fields: [assignedToId], references: [id], onDelete: SetNull)
  issuedDocuments IssuedDocument[]
  history      DocumentRequestStatusHistory[]

  @@index([memberId])
  @@index([status])
  @@index([trackingNo])
  @@map("document_requests")
}

model DocumentRequestStatusHistory {
  id        String                @id @default(cuid())
  requestId String                @map("request_id")
  fromStatus DocumentRequestStatus? @map("from_status")
  toStatus  DocumentRequestStatus @map("to_status")
  note      String?               @db.VarChar(500)
  changedBy String?               @map("changed_by")
  createdAt DateTime              @default(now()) @map("created_at")

  request DocumentRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([requestId])
  @@map("document_request_status_history")
}

model IssuedDocument {
  id                    String               @id @default(cuid())
  requestId             String               @map("request_id")
  documentNo            String               @unique @map("document_no") @db.VarChar(60)
  verificationTokenHash String               @map("verification_token_hash") @db.VarChar(255)
  status                IssuedDocumentStatus @default(valid)
  issuedAt              DateTime             @map("issued_at")
  expiresAt             DateTime?            @map("expires_at")
  revokedAt             DateTime?            @map("revoked_at")
  fileKey               String?              @map("file_key") @db.VarChar(500)
  createdAt             DateTime             @default(now()) @map("created_at")
  updatedAt             DateTime             @updatedAt @map("updated_at")

  request DocumentRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([documentNo])
  @@index([status])
  @@map("issued_documents")
}

// ─── Dues & payments ─────────────────────────────────────────────────────────

model DuesPeriod {
  id        String   @id @default(cuid())
  year      Int
  period    String   @db.VarChar(40)
  title     String   @db.VarChar(160)
  dueDate   DateTime @map("due_date") @db.Date
  amount    Decimal  @db.Decimal(12, 2)
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  memberDues MemberDue[]

  @@unique([year, period])
  @@map("dues_periods")
}

model MemberDue {
  id             String    @id @default(cuid())
  memberId       String    @map("member_id")
  periodId       String    @map("period_id")
  assessedAmount Decimal   @map("assessed_amount") @db.Decimal(12, 2)
  paidAmount     Decimal   @default(0) @map("paid_amount") @db.Decimal(12, 2)
  penaltyAmount  Decimal   @default(0) @map("penalty_amount") @db.Decimal(12, 2)
  status         DueStatus @default(unpaid)
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  member      Member              @relation(fields: [memberId], references: [id], onDelete: Cascade)
  period      DuesPeriod          @relation(fields: [periodId], references: [id], onDelete: Restrict)
  allocations PaymentAllocation[]

  @@unique([memberId, periodId])
  @@index([status])
  @@map("member_dues")
}

model Payment {
  id                String        @id @default(cuid())
  memberId          String        @map("member_id")
  amount            Decimal       @db.Decimal(12, 2)
  method            PaymentMethod @default(other)
  provider          String?       @db.VarChar(80)
  providerReference String?       @map("provider_reference") @db.VarChar(190)
  note              String?       @db.VarChar(500)
  status            PaymentStatus @default(pending)
  paidAt            DateTime?     @map("paid_at")
  createdById       String?       @map("created_by")
  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @updatedAt @map("updated_at")

  member      Member              @relation(fields: [memberId], references: [id], onDelete: Cascade)
  createdBy   User?               @relation("PaymentCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  allocations PaymentAllocation[]
  receipt     Receipt?

  @@index([memberId])
  @@index([status])
  @@index([providerReference])
  @@map("payments")
}

model PaymentAllocation {
  id          String  @id @default(cuid())
  paymentId   String  @map("payment_id")
  memberDueId String  @map("member_due_id")
  amount      Decimal @db.Decimal(12, 2)

  payment   Payment   @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  memberDue MemberDue @relation(fields: [memberDueId], references: [id], onDelete: Restrict)

  @@index([paymentId])
  @@index([memberDueId])
  @@map("payment_allocations")
}

model Receipt {
  id        String   @id @default(cuid())
  paymentId String   @unique @map("payment_id")
  receiptNo String   @unique @map("receipt_no") @db.VarChar(60)
  issuedAt  DateTime @map("issued_at")
  fileKey   String?  @map("file_key") @db.VarChar(500)
  createdAt DateTime @default(now()) @map("created_at")

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@map("receipts")
}

model PaymentWebhookEvent {
  id              String      @id @default(cuid())
  providerEventId String      @unique @map("provider_event_id") @db.VarChar(190)
  payloadHash     String      @map("payload_hash") @db.VarChar(128)
  status          JobStatus   @default(pending)
  processedAt     DateTime?   @map("processed_at")
  createdAt       DateTime    @default(now()) @map("created_at")

  @@map("payment_webhook_events")
}

// ─── Appointments & support ──────────────────────────────────────────────────

model AppointmentService {
  id              String   @id @default(cuid())
  name            String   @db.VarChar(160)
  slug            String   @unique @db.VarChar(180)
  durationMinutes Int      @default(30) @map("duration_minutes")
  active          Boolean  @default(true)
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  appointments Appointment[]
  schedules    AppointmentSchedule[]

  @@map("appointment_services")
}

model AppointmentLocation {
  id        String   @id @default(cuid())
  name      String   @db.VarChar(160)
  address   String?  @db.VarChar(500)
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  appointments Appointment[]
  schedules    AppointmentSchedule[]

  @@map("appointment_locations")
}

model AppointmentSchedule {
  id         String  @id @default(cuid())
  serviceId  String? @map("service_id")
  locationId String? @map("location_id")
  weekday    Int
  startTime  String  @map("start_time") @db.VarChar(5)
  endTime    String  @map("end_time") @db.VarChar(5)
  slotCapacity Int   @default(1) @map("slot_capacity")
  active     Boolean @default(true)

  service  AppointmentService?  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  location AppointmentLocation? @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@index([weekday])
  @@map("appointment_schedules")
}

model ClosedDay {
  id        String   @id @default(cuid())
  date      DateTime @unique @db.Date
  reason    String?  @db.VarChar(255)
  createdAt DateTime @default(now()) @map("created_at")

  @@map("closed_days")
}

model Appointment {
  id              String            @id @default(cuid())
  memberId        String?           @map("member_id")
  userId          String?           @map("user_id")
  serviceId       String            @map("service_id")
  locationId      String?           @map("location_id")
  staffUserId     String?           @map("staff_user_id")
  startAt         DateTime          @map("start_at")
  endAt           DateTime          @map("end_at")
  status          AppointmentStatus @default(pending)
  appointmentCode String            @unique @map("appointment_code") @db.VarChar(40)
  notes           String?           @db.Text
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")
  deletedAt       DateTime?         @map("deleted_at")

  member   Member?              @relation("AppointmentMember", fields: [memberId], references: [id], onDelete: SetNull)
  user     User?                @relation("AppointmentMemberUser", fields: [userId], references: [id], onDelete: SetNull)
  staff    User?                @relation("AppointmentStaffUser", fields: [staffUserId], references: [id], onDelete: SetNull)
  service  AppointmentService   @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  location AppointmentLocation? @relation(fields: [locationId], references: [id], onDelete: SetNull)

  @@unique([serviceId, startAt, locationId])
  @@index([status])
  @@index([startAt])
  @@index([memberId])
  @@map("appointments")
}

model SupportRequest {
  id          String               @id @default(cuid())
  trackingNo  String               @unique @map("tracking_no") @db.VarChar(40)
  type        SupportRequestType
  memberId    String?              @map("member_id")
  applicantName  String?           @map("applicant_name") @db.VarChar(160)
  applicantEmail String?           @map("applicant_email") @db.VarChar(190)
  applicantPhone String?           @map("applicant_phone") @db.VarChar(30)
  subject     String               @db.VarChar(255)
  message     String               @db.Text
  status      SupportRequestStatus @default(new)
  priority    String               @default("normal") @db.VarChar(20)
  assignedToId String?             @map("assigned_to")
  dueAt       DateTime?            @map("due_at")
  createdAt   DateTime             @default(now()) @map("created_at")
  updatedAt   DateTime             @updatedAt @map("updated_at")
  deletedAt   DateTime?            @map("deleted_at")

  member   Member?          @relation(fields: [memberId], references: [id], onDelete: SetNull)
  assignee User?            @relation("SupportAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  messages SupportMessage[]

  @@index([status])
  @@index([trackingNo])
  @@index([type])
  @@map("support_requests")
}

model SupportMessage {
  id         String                   @id @default(cuid())
  requestId  String                   @map("request_id")
  senderId   String?                  @map("sender_id")
  message    String                   @db.Text
  visibility SupportMessageVisibility @default(public)
  attachment String?                  @db.VarChar(500)
  createdAt  DateTime                 @default(now()) @map("created_at")

  request SupportRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  sender  User?          @relation(fields: [senderId], references: [id], onDelete: SetNull)

  @@index([requestId])
  @@map("support_messages")
}

// ─── Content ─────────────────────────────────────────────────────────────────

model Page {
  id              String        @id @default(cuid())
  title           String        @db.VarChar(255)
  slug            String        @unique @db.VarChar(255)
  content         String?       @db.LongText
  status          ContentStatus @default(draft)
  seoTitle        String?       @map("seo_title") @db.VarChar(255)
  seoDescription  String?       @map("seo_description") @db.VarChar(320)
  publishedAt     DateTime?     @map("published_at")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")
  deletedAt       DateTime?     @map("deleted_at")

  @@index([status, publishedAt])
  @@map("pages")
}

model PostCategory {
  id        String   @id @default(cuid())
  name      String   @db.VarChar(120)
  slug      String   @unique @db.VarChar(140)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  posts PostCategoryRelation[]

  @@map("post_categories")
}

model Post {
  id             String        @id @default(cuid())
  type           PostType
  title          String        @db.VarChar(255)
  slug           String        @unique @db.VarChar(255)
  excerpt        String?       @db.Text
  content        String?       @db.LongText
  coverImage     String?       @map("cover_image") @db.VarChar(500)
  status         ContentStatus @default(draft)
  featured       Boolean       @default(false)
  sortOrder      Int           @default(0) @map("sort_order")
  seoTitle       String?       @map("seo_title") @db.VarChar(255)
  seoDescription String?       @map("seo_description") @db.VarChar(320)
  publishedAt    DateTime?     @map("published_at")
  expiresAt      DateTime?     @map("expires_at")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")
  deletedAt      DateTime?     @map("deleted_at")

  categories PostCategoryRelation[]

  @@index([type, status, publishedAt])
  @@index([featured, sortOrder])
  @@index([slug])
  @@map("posts")
}

model PostCategoryRelation {
  postId     String @map("post_id")
  categoryId String @map("category_id")

  post     Post         @relation(fields: [postId], references: [id], onDelete: Cascade)
  category PostCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([postId, categoryId])
  @@map("post_category_relations")
}

model Event {
  id               String        @id @default(cuid())
  title            String        @db.VarChar(255)
  slug             String        @unique @db.VarChar(255)
  description      String?       @db.LongText
  eventType        String?       @map("event_type") @db.VarChar(80)
  location         String?       @db.VarChar(255)
  isOnline         Boolean       @default(false) @map("is_online")
  onlineUrl        String?       @map("online_url") @db.VarChar(500)
  startsAt         DateTime      @map("starts_at")
  endsAt           DateTime?     @map("ends_at")
  capacity         Int?
  registrationOpen DateTime?     @map("registration_open")
  registrationClose DateTime?    @map("registration_close")
  status           ContentStatus @default(draft)
  featured         Boolean       @default(false)
  sortOrder        Int           @default(0) @map("sort_order")
  coverImage       String?       @map("cover_image") @db.VarChar(500)
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")
  deletedAt        DateTime?     @map("deleted_at")

  registrations EventRegistration[]
  materials     EventMaterial[]

  @@index([status, startsAt])
  @@index([featured, sortOrder])
  @@map("events")
}

model EventRegistration {
  id        String                   @id @default(cuid())
  eventId   String                   @map("event_id")
  memberId  String?                  @map("member_id")
  userId    String?                  @map("user_id")
  status    EventRegistrationStatus  @default(registered)
  createdAt DateTime                 @default(now()) @map("created_at")
  updatedAt DateTime                 @updatedAt @map("updated_at")

  event  Event   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  member Member? @relation(fields: [memberId], references: [id], onDelete: SetNull)
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@unique([eventId, memberId])
  @@unique([eventId, userId])
  @@index([eventId, status])
  @@map("event_registrations")
}

model EventMaterial {
  id        String   @id @default(cuid())
  eventId   String   @map("event_id")
  title     String   @db.VarChar(255)
  fileKey   String   @map("file_key") @db.VarChar(500)
  createdAt DateTime @default(now()) @map("created_at")

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
  @@map("event_materials")
}

model FaqCategory {
  id        String   @id @default(cuid())
  name      String   @db.VarChar(160)
  slug      String   @unique @db.VarChar(180)
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  faqs Faq[]

  @@map("faq_categories")
}

model Faq {
  id         String        @id @default(cuid())
  categoryId String?       @map("category_id")
  question   String        @db.VarChar(500)
  answer     String        @db.Text
  status     ContentStatus @default(draft)
  sortOrder  Int           @default(0) @map("sort_order")
  createdAt  DateTime      @default(now()) @map("created_at")
  updatedAt  DateTime      @updatedAt @map("updated_at")

  category FaqCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@index([status, sortOrder])
  @@map("faqs")
}

model Resource {
  id          String             @id @default(cuid())
  category    String?            @db.VarChar(120)
  title       String             @db.VarChar(255)
  slug        String             @unique @db.VarChar(180)
  fileKey     String             @map("file_key") @db.VarChar(500)
  version     String?            @db.VarChar(40)
  fileSize    Int?               @map("file_size")
  mimeType    String?            @map("mime_type") @db.VarChar(120)
  visibility  ResourceVisibility @default(public)
  sortOrder   Int                @default(0) @map("sort_order")
  publishedAt DateTime?          @map("published_at")
  createdAt   DateTime           @default(now()) @map("created_at")
  updatedAt   DateTime           @updatedAt @map("updated_at")
  deletedAt   DateTime?          @map("deleted_at")

  @@index([visibility, publishedAt])
  @@index([sortOrder])
  @@map("resources")
}

model Media {
  id           String          @id @default(cuid())
  storageKey   String          @unique @map("storage_key") @db.VarChar(500)
  filename     String          @db.VarChar(255)
  mimeType     String          @map("mime_type") @db.VarChar(120)
  size         Int
  width        Int?
  height       Int?
  altText      String?         @map("alt_text") @db.VarChar(255)
  visibility   MediaVisibility @default(private)
  uploadedById String?         @map("uploaded_by")
  createdAt    DateTime        @default(now()) @map("created_at")
  updatedAt    DateTime        @updatedAt @map("updated_at")

  uploadedBy User? @relation("MediaUploader", fields: [uploadedById], references: [id], onDelete: SetNull)

  @@index([uploadedById])
  @@map("media")
}

model Menu {
  id        String   @id @default(cuid())
  name      String   @db.VarChar(120)
  location  String   @unique @db.VarChar(80)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  items MenuItem[]

  @@map("menus")
}

model MenuItem {
  id        String   @id @default(cuid())
  menuId    String   @map("menu_id")
  parentId  String?  @map("parent_id")
  label     String   @db.VarChar(160)
  href      String   @db.VarChar(500)
  sortOrder Int      @default(0) @map("sort_order")
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  menu     Menu       @relation(fields: [menuId], references: [id], onDelete: Cascade)
  parent   MenuItem?  @relation("MenuItemTree", fields: [parentId], references: [id], onDelete: SetNull)
  children MenuItem[] @relation("MenuItemTree")

  @@index([menuId, sortOrder])
  @@map("menu_items")
}

enum BannerVariant {
  text_cta
  media_cta
  image_link

  @@map("banner_variant")
}

/// Home hero carousel slides — not news/posts.
model Banner {
  id                String        @id @default(cuid())
  variant           BannerVariant @default(text_cta)
  eyebrow           String?       @db.VarChar(160)
  title             String        @db.VarChar(255)
  description       String?       @db.Text
  imageKey          String?       @map("image_key") @db.VarChar(500)
  mobileImageKey    String?       @map("mobile_image_key") @db.VarChar(500)
  primaryCtaLabel   String?       @map("primary_cta_label") @db.VarChar(120)
  primaryCtaHref    String?       @map("primary_cta_href") @db.VarChar(500)
  primaryCtaNewTab  Boolean       @default(false) @map("primary_cta_new_tab")
  secondaryCtaLabel String?       @map("secondary_cta_label") @db.VarChar(120)
  secondaryCtaHref  String?       @map("secondary_cta_href") @db.VarChar(500)
  secondaryCtaNewTab Boolean      @default(false) @map("secondary_cta_new_tab")
  sortOrder         Int           @default(0) @map("sort_order")
  active            Boolean       @default(true)
  startsAt          DateTime?     @map("starts_at")
  endsAt            DateTime?     @map("ends_at")
  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @updatedAt @map("updated_at")

  @@index([active, sortOrder])
  @@index([active, startsAt, endsAt])
  @@map("banners")
}

model SiteSetting {
  id        String   @id @default(cuid())
  key       String   @unique @db.VarChar(120)
  value     Json
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("site_settings")
}

model Redirect {
  id        String   @id @default(cuid())
  fromPath  String   @unique @map("from_path") @db.VarChar(500)
  toPath    String   @map("to_path") @db.VarChar(500)
  statusCode Int     @default(301) @map("status_code")
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("redirects")
}

model ContactSubmission {
  id        String    @id @default(cuid())
  name      String    @db.VarChar(160)
  email     String    @db.VarChar(190)
  phone     String?   @db.VarChar(30)
  subject   String?   @db.VarChar(255)
  message   String    @db.Text
  status    String    @default("new") @db.VarChar(40)
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  @@index([status, createdAt])
  @@map("contact_submissions")
}

model NewsletterSubscriber {
  id           String    @id @default(cuid())
  email        String    @unique @db.VarChar(190)
  consentAt    DateTime  @map("consent_at")
  consentVersion String  @map("consent_version") @db.VarChar(40)
  unsubscribedAt DateTime? @map("unsubscribed_at")
  createdAt    DateTime  @default(now()) @map("created_at")

  @@map("newsletter_subscribers")
}

// ─── System ──────────────────────────────────────────────────────────────────

model NotificationTemplate {
  id        String   @id @default(cuid())
  key       String   @unique @db.VarChar(120)
  channel   String   @db.VarChar(40)
  subject   String?  @db.VarChar(255)
  body      String   @db.Text
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("notification_templates")
}

model Notification {
  id        String    @id @default(cuid())
  userId    String    @map("user_id")
  channel   String    @db.VarChar(40)
  title     String    @db.VarChar(255)
  body      String    @db.Text
  payload   Json?
  readAt    DateTime? @map("read_at")
  sentAt    DateTime? @map("sent_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@map("notifications")
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?  @map("actor_id")
  action     String   @db.VarChar(120)
  entityType String   @map("entity_type") @db.VarChar(120)
  entityId   String?  @map("entity_id") @db.VarChar(80)
  beforeJson Json?    @map("before_json")
  afterJson  Json?    @map("after_json")
  ipHash     String?  @map("ip_hash") @db.VarChar(128)
  userAgent  String?  @map("user_agent") @db.VarChar(512)
  createdAt  DateTime @default(now()) @map("created_at")

  actor User? @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([actorId, createdAt])
  @@index([action])
  @@map("audit_logs")
}

model Job {
  id          String    @id @default(cuid())
  queue       String    @db.VarChar(80)
  name        String    @db.VarChar(120)
  payload     Json
  status      JobStatus @default(pending)
  attempts    Int       @default(0)
  availableAt DateTime  @default(now()) @map("available_at")
  reservedAt  DateTime? @map("reserved_at")
  completedAt DateTime? @map("completed_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@index([queue, status, availableAt])
  @@map("jobs")
}

model FailedJob {
  id         String   @id @default(cuid())
  queue      String   @db.VarChar(80)
  name       String   @db.VarChar(120)
  payload    Json
  error      String   @db.Text
  failedAt   DateTime @default(now()) @map("failed_at")

  @@index([queue, failedAt])
  @@map("failed_jobs")
}

model FeatureFlag {
  id          String   @id @default(cuid())
  key         String   @unique @db.VarChar(120)
  enabled     Boolean  @default(false)
  description String?  @db.VarChar(255)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("feature_flags")
}
