# Production environment template for Coolify
# Copy values into Coolify → Application → Environment Variables.
# Do not commit real secrets.

NODE_ENV=production
PORT=3000
HOSTNAME=0.0.0.0

# Public site URL (no trailing slash)
NEXT_PUBLIC_APP_URL=https://YOURDOMAIN
NEXT_PUBLIC_SITE_NAME=İstanbul Çiçekçiler Esnaf Odası
NEXT_PUBLIC_TRY_PER_EUR=54

# Auth (generate: openssl rand -hex 32)
AUTH_SECRET=
AUTH_URL=https://YOURDOMAIN

# Cookie Secure flag: leave unset to follow NEXT_PUBLIC_APP_URL (https → true).
# For temporary HTTP IP access set: COOKIE_SECURE=false
# COOKIE_SECURE=false

# Optional dedicated field encryption key (else AUTH_SECRET is used)
# FIELD_ENCRYPTION_KEY=

# MySQL — prefer Coolify internal URL (same Docker network)
# Example: mysql://USER:PASSWORD@iceo-mysql:3306/istanbul_cicekciler_odasi
DATABASE_URL=

# Or split vars (adapter also accepts these):
# MYSQL_HOST=iceo-mysql
# MYSQL_PORT=3306
# MYSQL_USER=iceo
# MYSQL_PASSWORD=
# MYSQL_DATABASE=istanbul_cicekciler_odasi

# Bootstrap admin (seed / first setup only — change after first login)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_EMAIL=admin@YOURDOMAIN

# Payments: keep mock until real iyzico production keys exist
PAYMENT_PROVIDER=mock
IYZI_API_KEY=
IYZI_SECRET_KEY=
IYZI_BASE_URL=https://api.iyzipay.com
